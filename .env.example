# Vektor Application Configuration
# Copy this file to .env for local development. Never commit .env with real secrets.

VEKTOR_APP_NAME=Vektor
VEKTOR_APP_VERSION=0.1.0
VEKTOR_APP_ENV=development
VEKTOR_DEBUG=false

# LLM Provider Configuration (OpenAI-compatible)
VEKTOR_LLM_PROVIDER_NAME=openai-compatible
VEKTOR_LLM_API_KEY=
VEKTOR_LLM_BASE_URL=https://api.openai.com/v1
VEKTOR_LLM_DEFAULT_MODEL=gpt-4o-mini
VEKTOR_LLM_TIMEOUT_SECONDS=30.0


# Optional RAG & Observability Upgrades
# VEKTOR_LLM_EMBEDDING_BACKEND=auto            # auto | openai-compatible | voyage | ollama | local-bge | local-hash
# VEKTOR_RETRIEVAL_RERANKER=heuristic          # heuristic | voyage | local-bge
# VEKTOR_RETRIEVAL_RERANKER_MODEL=rerank-2-lite
# VEKTOR_KNOWLEDGE_CHUNKING_STRATEGY=procedure # procedure | semantic
# VEKTOR_LANGFUSE_ENABLED=false
# VEKTOR_LANGFUSE_PUBLIC_KEY=
# VEKTOR_LANGFUSE_SECRET_KEY=
# VEKTOR_LANGFUSE_HOST=https://cloud.langfuse.com

# Web tools (no API key required by default)
VEKTOR_WEB_TOOLS_ENABLED=true
VEKTOR_WEB_SEARCH_PROVIDER=searxng
# searxng works without a key using public instances; duckduckgo is an alternative.
# Set your own instance for stable results (JSON must be enabled in search.formats):
# VEKTOR_WEB_SEARXNG_URL=http://127.0.0.1:8080
VEKTOR_WEB_MAX_SEARCHES=3
VEKTOR_WEB_MAX_FETCHES=3
VEKTOR_WEB_MAX_RESULTS=5
VEKTOR_WEB_FETCH_TIMEOUT_SECONDS=10
VEKTOR_WEB_MAX_PAGE_CHARS=6000

# --- Login (OAuth) ---------------------------------------------------------
# Public URL of the deployed frontend; OAuth callbacks come back through its proxy.
VEKTOR_PUBLIC_FRONTEND_URL=http://localhost:3000
# Random 32+ char string used to sign OAuth state; required for login.
VEKTOR_AUTH_SESSION_SECRET=
# Leave a provider blank to hide its button.
VEKTOR_OAUTH_GOOGLE_CLIENT_ID=
VEKTOR_OAUTH_GOOGLE_CLIENT_SECRET=
VEKTOR_OAUTH_GITHUB_CLIENT_ID=
VEKTOR_OAUTH_GITHUB_CLIENT_SECRET=
