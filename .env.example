# Vektor Application Configuration
# Copy this file to .env for local development. Never commit .env with real secrets.

VEKTOR_APP_NAME=Vektor
VEKTOR_APP_VERSION=0.1.0
VEKTOR_APP_ENV=development
VEKTOR_DEBUG=false

# LLM Provider Configuration (OpenAI-compatible)
VEKTOR_LLM_PROVIDER_NAME=openai-compatible
VEKTOR_LLM_API_KEY=
VEKTOR_LLM_BASE_URL=https://api.openai.com/v1
VEKTOR_LLM_DEFAULT_MODEL=gpt-4o-mini
VEKTOR_LLM_TIMEOUT_SECONDS=30.0


# Optional RAG & Observability Upgrades
# VEKTOR_LLM_EMBEDDING_BACKEND=auto            # auto | openai-compatible | voyage | ollama | local-bge | local-hash
# VEKTOR_RETRIEVAL_RERANKER=heuristic          # heuristic | voyage | local-bge
# VEKTOR_RETRIEVAL_RERANKER_MODEL=rerank-2-lite
# VEKTOR_KNOWLEDGE_CHUNKING_STRATEGY=procedure # procedure | semantic
# VEKTOR_LANGFUSE_ENABLED=false
# VEKTOR_LANGFUSE_PUBLIC_KEY=
# VEKTOR_LANGFUSE_SECRET_KEY=
# VEKTOR_LANGFUSE_HOST=https://cloud.langfuse.com
